# 複製成 .env 後填寫；.env 不會進版控。留空代表不使用該功能。

# ---- Google Drive（透過 rclone）----
# rclone remote 名稱：先執行 rclone config 建立一個 Google Drive remote（預設叫 gdrive）
DRIVE_REMOTE=
# 上傳到 Drive 的資料夾名稱（預設 YouTube投影片）
DRIVE_DIR=
# 選填：只想放進某個特定資料夾時，填該資料夾網址最後那段 ID
DRIVE_ROOT_FOLDER_ID=

# ---- Gmail（透過 SMTP）----
# 寄件的 Gmail 帳號，例如 someone@gmail.com
GMAIL_USER=
# Gmail 應用程式密碼（16 碼，不是登入密碼）：
#   1. Google 帳戶先開啟「兩步驟驗證」
#   2. 到 https://myaccount.google.com/apppasswords 建立應用程式密碼並貼到這裡
GMAIL_APP_PASSWORD=
# 收件人；留空就寄給 GMAIL_USER 自己
MAIL_TO=
